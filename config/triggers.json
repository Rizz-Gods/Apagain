      },
      "tasks": [
        {
          "capability": "social-control",
          "action": "attention",
          "priority": 78,
          "payload": {
            "input_from": "event.task",
            "risk": "safe"
          }
        }
      ]
    },
    {
      "id": "media-failure-attention",
      "enabled": true,
      "event": {
        "kind": "task.failed",
        "capability": "media-production"
      },
      "tasks": [
        {
          "capability": "social-control",
          "action": "attention",
          "priority": 70,
          "payload": {
            "input_from": "event.task",
            "risk": "safe"
          }
        }
      ]
    }
  ]
