{
  "triggers": [
    {
      "id": "approval-attention",
      "enabled": true,
      "event": {
        "kind": "task.approval_required",
        "capability": "social-actions"
      },
      "tasks": [
        {
          "capability": "social-control",
          "action": "attention",
          "priority": 80,
          "payload": {
            "input_from": "event.task",
            "risk": "safe"
          }
        }
      ]
    },
    {
      "id": "social-failure-attention",
      "enabled": true,
      "event": {
